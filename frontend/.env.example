# Copy to .env.local only if you need personal overrides (optional)
#
# Local dev uses .env.development automatically:
#   VITE_API_URL=http://localhost:5000/api
#
# Production build uses .env.production automatically:
#   VITE_API_URL=https://expense-tracker-crd4.onrender.com/api
#
# On Vercel you can instead set Environment Variable:
#   VITE_API_URL = https://expense-tracker-crd4.onrender.com/api
